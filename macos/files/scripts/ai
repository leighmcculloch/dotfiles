#!/usr/bin/env bash
set -euo pipefail

# CLI Approach:
# To import the model first:
#   litert-lm import --from-huggingface-repo=litert-community/gemma-4-E2B-it-litert-lm gemma-4-E2B-it.litertlm
# litert-lm run gemma-4-E2B-it.litertlm --prompt="$*"

#    model: "gemma-4-e2b-it-mlx@4bit",

# LM-Studio Approach:
curl -sS http://${GEMMA_HOST:-localhost}:1234/api/v1/chat \
  -H "Content-Type: application/json" \
  -d "$(jq -n --arg input "$*" '{
    model: "qwen/qwen3.8-27b",
    system_prompt: "You are a senior software engineer. Be very concise.",
    input: $input,
    reasoning: "off",
    integrations: [
    ]
  }')" \
  | jq -r '.output[] | select(.type=="message") | .content'

