# Bracketed paste: auto-wrap complex text (newlines/quotes) in a heredoc
conditional_heredoc_paste() {
  emulate -L zsh -o extended_glob
  # Save buffer state, then let the built-in widget collect the paste
  local save_LBUFFER=$LBUFFER save_RBUFFER=$RBUFFER
  LBUFFER="" RBUFFER=""
  zle .bracketed-paste
  local pasted=$LBUFFER
  LBUFFER=$save_LBUFFER
  RBUFFER=$save_RBUFFER
  local stripped=${pasted%%$'\n'##}
  if [[ -n $save_LBUFFER && ($stripped == *$'\n'* || $pasted == *\'* || $pasted == *\"*) ]]; then
    local delim="EOF_${RANDOM}_${RANDOM}_EOF"
    LBUFFER+="\"\$(cat <<'${delim}'"$'\n'"${pasted}"$'\n'"${delim}"$'\n)\"'
  else
    LBUFFER+="$pasted"
  fi
}
zle -N bracketed-paste conditional_heredoc_paste

