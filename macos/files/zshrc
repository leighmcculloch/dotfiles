function caff() {
  mkdir -p /tmp/caffeinate
  pushd /tmp/caffeinate
  echo 'Preventing sleep... Ctrl-C to release.'
  trap 'popd; rm -rf /tmp/caffeinate; trap - INT; return' INT
  caffeinate -i "$@"
  trap - INT
  popd
  rm -rf /tmp/caffeinate
}
