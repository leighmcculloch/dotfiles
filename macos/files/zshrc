# Tmux
if (( $+commands[tmux] )); then
  # Auto-start tmux in ghostty or SSH
  if [[ -z "$TMUX" && ("$TERM_PROGRAM" == "ghostty" || -n "$SSH_CLIENT") ]]; then
    if [[ "$GHOSTTY_QUICK_TERMINAL" == "1" ]]; then
      tmux attach -t popup 2>/dev/null || tmux new-session -s popup -c ~/Code/scratch
    else
      tmux attach -t main 2>/dev/null || tmux new-session -s main
    fi
  fi
  alias clear="tmux send-keys C-l \; send-keys -R \; clear-history"

  # Auto-regroup windows by git repo when cd'ing inside a tmux pane
  if [[ -n "$TMUX" ]]; then
    autoload -Uz add-zsh-hook
    _tmux_auto_regroup() { tmux-regroup-windows &! }
    add-zsh-hook chpwd _tmux_auto_regroup
  fi
fi

